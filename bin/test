#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build/tests"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to test signed." >&2
  exit 1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/tests/signed_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./signed_tests "$@"

# Real wheel events against Main.qml, independently of PDF decoding.
mkdir -p "$ROOT/build/scroll-tests"
cd "$ROOT/build/scroll-tests"
"$QMAKE" "$ROOT/tests/scroll_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./scroll_tests

# The command line is tested as an agent uses it: the built binary, no display.
"$ROOT/bin/build" >/dev/null
python3 -m unittest discover -s "$ROOT/tests" -p 'test_*.py'
