# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=signed
pkgver=0.3.1
pkgrel=1
pkgdesc='Sign PDFs and fill them in with text and dates'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/signed'
license=('MIT')
install='signed.install'
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'poppler-qt6' 'qpdf' 'nss' 'noto-fonts' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'poppler-qt6' 'qpdf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/signed "$pkgdir/usr/bin/signed"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/signed.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/signed.svg"
  /usr/bin/install -Dm644 "$startdir/signed.desktop" "$pkgdir/usr/share/applications/signed.desktop"
}
